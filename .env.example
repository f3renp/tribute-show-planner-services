# Copy to .env to change these. Everything has a default, so no .env is
# needed to run docker compose up --build.

# Addresses the browser uses for the links between the two services' pages.
# Change them if you publish the services on other host ports or a domain.
CATALOGUE_PUBLIC_URL=http://localhost:8001
SHOWS_PUBLIC_URL=http://localhost:8002

# Set in docker-compose.yml, listed here for reference:
# CATALOGUE_URL=http://catalogue:8000   (how shows calls the catalogue API)
# PORT=8000                             (port inside each container)
# DATA_DIR=/data                        (folder for each service's SQLite file)
